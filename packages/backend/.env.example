# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as g; print(g())'
DJANGO_SECRET_KEY=

# Off in production. When off, DJANGO_SECRET_KEY is required and the
# HTTPS/secure-cookie settings switch on automatically.
DJANGO_DEBUG=False

# Comma separated. Real hostnames only — "*" is rejected at startup.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Needed for cookie/session POSTs from the deployed frontend, e.g.
# https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=

# Managed Postgres. REQUIRED in production: serverless and container hosts have
# ephemeral disks, so the default SQLite file is wiped on every deploy.
# e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# "mandatory" in production so signups must confirm a real address.
# Defaults to mandatory whenever DJANGO_DEBUG is off.
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Rate limits (DRF format "<count>/<period>").
THROTTLE_ANON=60/hour
THROTTLE_USER=1000/hour
THROTTLE_CHECK_ANSWER=120/hour
THROTTLE_AUTH=10/hour

# HSTS: start low, raise once every subdomain is HTTPS. Browsers cache it.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_SSL_REDIRECT=True

# Google OAuth — keep these in the environment, not in the SocialApp DB row.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
